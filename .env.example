# Jev MCP Configuration
#
# Copy this file to `.env` in the repository root. `jev_mac_manager.sh` sources it,
# and the MCP server loads it through python-dotenv when that package is installed.
# Every variable is optional; the values shown are the defaults.

# Port of the fast engine (Kev 0.8B llama-server).
# Change this if another service (e.g. a React frontend) is already using 8080.
JEV_FAST_PORT=8080

# Port of the smart engine (Qwen 7B llama-server).
JEV_SMART_PORT=8081

# Fast-tier backend: "kev" uses KevProvider (/v1/systemone); any other value
# uses DaemonProvider (/v1/chat/completions) on the fast port.
JEV_FAST_ENGINE=kev

# Optional override for a DaemonProvider built without an explicit URL.
# Leave unset: it then follows JEV_SMART_PORT. The router derives its own URLs
# from JEV_FAST_PORT / JEV_SMART_PORT and ignores this.
# JEV_DAEMON_PORT=8081

# Number of llama-server parallel slots (context is 16384 tokens per slot).
# Leave unset to size it from system RAM (halved for 7B models).
# JEV_BATCH_SIZE=4

# Bearer token required by the email-triage webhook (POST /api/v1/triage/email).
# Set this to a long random string of your own; never commit the real value.
# JEV_MCP_API_KEY=

# Optional: also accept JWTs on the webhook. Use the identity provider's JWKS URL
# (RS256/ES256), or a shared HS256 secret of at least 32 random bytes; never commit a real secret.
# JEV_MCP_JWKS_URL=https://your-idp.example/.well-known/jwks.json
# JEV_MCP_JWT_SECRET=
# JEV_MCP_JWT_AUDIENCE=
# JEV_MCP_JWT_ISSUER=

# Location of the jev-ultrafast checkout used by run-browser-agent (default: ./jev-ultrafast).
# JEV_ULTRAFAST_PATH=

# Your own directory holding llama.cpp's convert_hf_to_gguf.py (with conversion/ and gguf-py/).
# Leave unset: train then keeps ~/.jev/llama.cpp-src in step with the installed llama-server by
# downloading the converter for its commit. When set, train never downloads into this directory.
# JEV_LLAMA_CPP_SRC=
